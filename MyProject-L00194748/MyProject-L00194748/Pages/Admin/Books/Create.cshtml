@page
@model MyProject_L00194748.Pages.Admin.Books.CreateModel
@{
}
<form method="post" enctype="multipart/form-data">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <div class="col-9">

            <h2 class="text-primary pl-3">Create New Book</h2>
        </div>
        <div class="mb-3">
            <label asp-for="@Model.Book.Title"></label>
            <input asp-for="@Model.Book.Title" class="form-control" />
            <span asp-validation-for="@Model.Book.Title" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="@Model.Book.Author"></label>
            <input asp-for="@Model.Book.Author" class="form-control" />
            <span asp-validation-for="@Model.Book.Author" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="@Model.Book.BookTypeID">Book Type</label>
            <select asp-for="@Model.Book.BookTypeID" asp-items="@Model.BookTypeList" class="form-control">
                <option disabled selected>Select Book Type</option>
            </select>
            <span asp-validation-for="@Model.Book.BookTypeID" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>Select Themes</label>
            <div class="row">
                    @foreach(var theme in Model.Themes)
                    {
                        <div class="col-4">
                            `<div class="form-check">
                                <input type="checkbox" class="form-check-input"
                                id="theme_@theme.Value"
                                       name="BookThemesVM.SelectedThemesIds" 
                                       value="@theme.Value"/>
                                <label class="form-check-label" for="theme_@theme.Value">
                                    @theme.Text
                                </label>
                            </div>
                        </div>
                    }
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="@Model.Book.Price"></label>
            <input asp-for="@Model.Book.Price" class="form-control" />
            <span asp-validation-for="@Model.Book.Price" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="@Model.Book.Description"></label>
            <textarea rows="8" asp-for="@Model.Book.Description" class="form-control"></textarea>
            <span asp-validation-for="@Model.Book.Description" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="@Model.Book.CoverImage">File Upload</label>
            <input type="file" name="files" id="upLoadBox" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-page="Index" class="btn btn-secondary">Back To Index</a>
        </div>
    </div>
</form>
@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}