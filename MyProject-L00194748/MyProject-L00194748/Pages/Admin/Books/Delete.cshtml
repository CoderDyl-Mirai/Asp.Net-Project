@page
@model MyProject_L00194748.Pages.Admin.Books.DeleteModel
@{
}
<form method="post" enctype="multipart/form-data">
    <input hidden asp-for="Book.Id" />

    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <div class="col-9">

            <h2 class="text-primary pl-3">Delete Book</h2>
        </div>
        <div class="mb-3">
            <label asp-for="@Model.Book.Title"></label>
            <input disabled asp-for="@Model.Book.Title" class="form-control" />
            <span asp-validation-for="@Model.Book.Title" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="@Model.Book.Author"></label>
            <input disabled asp-for="@Model.Book.Author" class="form-control" />
            <span asp-validation-for="@Model.Book.Author" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="@Model.Book.BookTypeID">Book Type</label>
            <select disabled asp-for="@Model.Book.BookTypeID" asp-items="@Model.BookTypeList" class="form-control">
                <option disabled selected>Select Category</option>
            </select>
            <span asp-validation-for="@Model.Book.BookTypeID" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="@Model.Book.Price"></label>
            <input disabled asp-for="@Model.Book.Price" class="form-control" />
            <span asp-validation-for="@Model.Book.Price" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="@Model.Book.Description"></label>
            <textarea disabled rows="8" asp-for="@Model.Book.Description" class="form-control"></textarea>
            <span asp-validation-for="@Model.Book.Description" class="text-danger"></span>
        </div>
        <div class="col-3">
            <img src="@Model.Book.CoverImage" />
        </div>
        <br />
        <button type="submit" class="btn btn-primary">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Back To Index</a>
        </div>
    </div>
</form>
@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}